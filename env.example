# ---- required ----
# The login ID of the site owner. Register with exactly this ID right after the first deploy.
OWNER_USERNAME=your_owner_id

# ---- database (pick one) ----
# A) Free hosts with a temporary disk (e.g. Render free plan): use Turso. Both values are required.
#TURSO_URL=libsql://your-db-your-org.turso.io
#TURSO_AUTH_TOKEN=xxxxxxxx
# B) A machine with a permanent disk (your own PC, a VPS, Docker volume): a local SQLite file is used.
#DATA_DIR=./data

# ---- optional ----
#PORT=3000
#MAX_UPLOAD_MB=20          # per file (default 20, or 4 when TURSO_URL is set)
#MAX_USER_UPLOAD_MB=200    # total uploads per account
#MAX_USER_DOC_MB=30        # image data kept in documents per account
#REGISTER_PER_HOUR=10      # new accounts per IP per hour
#WRITES_PER_MIN=240        # writes per account per minute
#TRUST_PROXY=1             # trust X-Forwarded-For (set automatically on Render)
#COOKIE_SECURE=1           # Secure cookies (set automatically on Render / NODE_ENV=production)
